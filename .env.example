# ==============================================================================
# SmartStock AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
# Never commit real credentials or .env to version control.
# ==============================================================================

# Application Port
PORT=8080

# Environment Mode (development, staging, production)
APP_ENV=production
APP_NAME="SmartStock AI"

# Container Registry Configuration
CONTAINER_REGISTRY=docker.io
IMAGE_NAME=phutaneprathamesh829/smart-stock

# Jira Cloud Integration Settings
# Example Base URL: https://your-company.atlassian.net
JIRA_BASE_URL=https://your-workspace.atlassian.net
JIRA_PROJECT_KEY=STOCK
JIRA_USER_EMAIL=devops@example.com
JIRA_API_TOKEN=your_jira_api_token_here

# GitHub Integration
GITHUB_REPO=phutaneprathamesh829-lang/smart-stock
